<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.proyectofinal.controller.LoginController"
            prefWidth="400" prefHeight="250">

    <VBox spacing="15" layoutX="100" layoutY="60">

        <Label text="Login" style="-fx-font-size: 22px;"/>

        <TextField fx:id="usernameField" promptText="Nombre de usuario"/>

        <Button text="Entrar" onAction="#onLoginClick" prefWidth="150"/>

    </VBox>

</AnchorPane>
