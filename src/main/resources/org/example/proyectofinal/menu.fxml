<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.proyectofinal.controller.MenuController"
            prefWidth="400" prefHeight="300">

    <children>

        <VBox spacing="15" layoutX="120" layoutY="80">

            <Button text="Ver series"
                    prefWidth="160"
                    onAction="#onShowSeries"/>

            <Button text="Series vistas"
                    prefWidth="160"
                    onAction="#onShowViewed"/>

            <Button text="Cerrar sesión"
                    prefWidth="160"
                    onAction="#onLogout"/>

        </VBox>

    </children>

</AnchorPane>
